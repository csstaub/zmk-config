// Toucan2 keymap ported from the csstaub42 QMK keymap for the Iris LM,
// minus the text macros and the accent layer.
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define SYM_L 1
#define SYM_R 2
#define MDA   3
#define NAV   4
#define MOUSE 5

// Key positions: row 1 = 0-11, row 2 = 12-23, row 3 = 24-35, thumbs = 36-41
#define KEYS_L   0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R   6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS_L 36 37 38
#define THUMBS_R 39 40 41

#define HYPR LS(LC(LA(LGUI)))

// The Toucan2 shield puts the trackpad into scroll mode on layers 1 and 2
// (Beekeeb's stock Nav/Sym). Point it at our Nav layer instead.
// Two-finger scroll felt too fast at the shield's 1/20, so halve it to 1/40.
&trackpad_listener {
    input-processors = <&zip_xy_scaler 100 100>, <&zip_scroll_scaler 1 40>,
                       <&zip_zoom_mapper>, <&is_touching_processor>, <&swipe_button_mapper>;
    scroller {
        layers = <NAV>;
    };
};

// The shield activates layer 4 while a finger is on the trackpad so the thumb
// keys become mouse buttons. Layer 4 is Nav here, so point it at Mouse.
&is_touching_processor {
    bindings = <&mo MOUSE>;
};

/ {
    behaviors {
        // Home row mods. PERMISSIVE_HOLD -> balanced, FLOW_TAP_TERM -> require-prior-idle-ms,
        // CHORDAL_HOLD -> only the opposite hand settles as hold.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <140>;
            hold-trigger-key-positions = <KEYS_R THUMBS_R>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <140>;
            hold-trigger-key-positions = <KEYS_L THUMBS_L>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Thumb layer-taps with the same opposite-hand rule. No hold-trigger-on-release:
        // it only exists for stacking same-hand mods, and on a layer-tap it delays the
        // positional check so a same-hand roll that outlasts the tapping term drops the tap.
        ltl: layer_tap_left_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            hold-trigger-key-positions = <KEYS_R THUMBS_R>;
            bindings = <&mo>, <&kp>;
        };
        ltr: layer_tap_right_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            hold-trigger-key-positions = <KEYS_L THUMBS_L>;
            bindings = <&mo>, <&kp>;
        };
        // Shift + Backspace = Delete
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // One-shot shift. QMK one-shot has no timeout, so use a long one.
        osm: one_shot_mod {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            release-after-ms = <60000>;
            quick-release;
            bindings = <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        // Both shifts together = caps word
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <24 35>;
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&kp TAB    &kp Q  &kp W        &kp E         &kp R        &kp T         &kp Y        &kp U        &kp I         &kp O        &kp P     &kp MINUS
&kp GRAVE  &kp A  &hml LALT S  &hml LCTRL D  &hml LGUI F  &hml HYPR G   &hmr HYPR H  &hmr RGUI J  &hmr RCTRL K  &hmr RALT L  &kp SEMI  &kp SQT
&osm LSHFT &kp Z  &kp X        &kp C         &kp V        &kp B         &kp N        &kp M        &kp COMMA     &kp DOT      &kp FSLH  &osm RSHFT
                         &mo NAV  &ltl SYM_R ESC  &bspc_del        &kp RET  &ltr SYM_L SPACE  &mo MDA
            >;
        };

        sym_l {
            display-name = "SYM";
            bindings = <
&kp EQUAL  &kp LBRC  &kp AMPS  &kp PIPE   &kp UNDER  &kp LBKT   &trans &trans &trans &trans &trans &trans
&kp TILDE  &kp RBRC  &kp DLLR  &kp PRCNT  &kp CARET  &kp RBKT   &trans &trans &trans &trans &trans &trans
&trans     &kp LT    &kp EXCL  &kp AT     &kp HASH   &kp GT     &trans &trans &trans &trans &trans &trans
                               &trans &trans &trans   &trans &trans &trans
            >;
        };

        sym_r {
            display-name = "SYM";
            bindings = <
&trans &trans &trans &trans &trans &trans   &kp PLUS   &kp N7  &kp N8  &kp N9  &kp LPAR  &kp STAR
&trans &trans &trans &trans &trans &trans   &kp MINUS  &kp N4  &kp N5  &kp N6  &kp RPAR  &kp BSLH
&trans &trans &trans &trans &trans &trans   &kp N0     &kp N1  &kp N2  &kp N3  &kp FSLH  &trans
                     &trans &trans &trans   &trans &trans &trans
            >;
        };

        mda {
            display-name = "MEDIA";
            bindings = <
&trans  &trans  &trans      &kp F14               &kp F15               &trans   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&trans  &trans  &kp C_MUTE  &kp LS(LA(K_VOL_DN))  &kp LS(LA(K_VOL_UP))  &trans   &out OUT_TOG  &trans        &trans        &trans        &trans        &studio_unlock
&trans  &trans  &trans      &trans                &trans                &bootloader   &bootloader   &trans        &trans        &trans        &trans        &trans
                                   &trans &trans &trans   &trans &trans &trans
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans   &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &trans &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans   &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &trans &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans   &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans     &trans &trans
                     &trans &trans &trans   &trans &trans &trans
            >;
        };

        // Active while a finger is on the trackpad: thumbs become mouse buttons.
        mouse {
            display-name = "MOUSE";
            bindings = <
&trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
         &mkp MCLK  &mkp LCLK  &mkp RCLK   &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };

        extra_1 { status = "reserved"; };
        extra_2 { status = "reserved"; };
    };
};
